generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Request {
    id        Int      @id @default(autoincrement())
    name      String
    email     String
    phone     String
    message   String
    status    String   @default("new")
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Admin {
    id        Int      @id @default(autoincrement())
    login     String   @unique
    password  String
    createdAt DateTime @default(now())
}
